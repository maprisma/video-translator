#!/usr/bin/env python3
"""Compile the checked-in catalogs for Dart and Rust. No network or dependencies."""
import json
from pathlib import Path
ROOT = Path(__file__).resolve().parents[1]
catalogs = {}
for code in ('en', 'de', 'fr', 'es', 'it', 'pt', 'nl', 'pl'):
    catalogs[code] = {}
    for folder in ('translations', 'translations/extra'):
        catalogs[code].update(json.loads((ROOT / folder / f'{code}.json').read_text()))
encoded = json.dumps(catalogs, ensure_ascii=False, sort_keys=True)
(ROOT / 'control/src/translations.json').write_text(encoded + '\n')
# JSON is also valid Dart for these string maps. Escape Dart interpolation.
(ROOT / 'app/lib/translations.g.dart').write_text('// Generated by tools/gen-translations.\nconst Map<String, Map<String, String>> catalogs = ' + encoded.replace('$', r'\$') + ';\n')
